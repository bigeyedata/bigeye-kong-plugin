_format_version: "3.0"

consumers:
  - username: test-ai-agent
    custom_id: agent-12345
    keyauth_credentials:
      - key: my-secret-api-key

services:
  - name: mock-service
    url: http://httpbin.org/anything
    routes:
      - name: mock-route
        paths:
          - /query
        strip_path: false
    plugins:
      - name: key-auth
        config:
          key_names:
            - apikey
      - name: bigeye-kong-plugin
        config:
          bigeye_url: http://host.docker.internal:8080
          username: <username>
          password: <password>
          timeout: 5000
